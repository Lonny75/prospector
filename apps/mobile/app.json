{
  "expo": {
    "name": "Prospectora",
    "slug": "prospector",
    "scheme": "prospector",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.prospector.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Prospector a besoin du micro pour simuler l'appel avec le prospect IA."
      }
    },
    "android": {
      "package": "com.prospector.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#232323"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEEDEA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "49f6a61f-5d2a-41a4-9935-9de03f3a10c7"
      }
    },
    "owner": "prospector"
  }
}
