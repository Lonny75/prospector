# PostgreSQL (Railway) — même pattern que Mastering France
DATABASE_URL=postgresql://user:password@host:5432/prospector

# Anthropic — cerveau du prospect (Sonnet 5) + moteur de débrief (Opus 4.8) + validation (Haiku 4.5)
ANTHROPIC_API_KEY=

# ElevenLabs — utilisé côté dashboard/config d'agent, pas directement par ce backend en Phase 0/1
# (le custom LLM est appelé PAR ElevenLabs vers /voice/llm/chat/completions, pas l'inverse)
ELEVENLABS_API_KEY=

PORT=3001
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

